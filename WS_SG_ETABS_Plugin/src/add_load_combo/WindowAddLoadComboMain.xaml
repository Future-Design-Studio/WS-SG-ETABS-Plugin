<Window x:Class="WS_SG_ETABS_Plugin.src.add_load_combo.WindowAddLoadComboMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.add_load_combo"
             mc:Ignorable="d" Height="600" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*"></RowDefinition>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="3.6*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Margin="0 -10 0 0" Content="Add Load Combination" FontSize="28"/>

        <TextBlock Grid.Row="1" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Justify"  
                   Margin="10 0 10 0" FontSize="10">
                How to use:<LineBreak/>
                1. Modify load combination name<LineBreak/>
                2. Modify load combination type<LineBreak/>
                3. Modify load case(s) or combination(s) factor<LineBreak/>
                4. Choose load case(s) or combination(s) to be add into the combination. If multipled load case(s) or combination(s) are selected, 
                    same load factors will be applied to all selected load case(s) or combination(s).<LineBreak/>
        </TextBlock>

        <Label Grid.Row="2" Grid.Column="0" Content="1. Load combo name and type" FontSize="14" FontWeight="Bold"/>

        <Grid Grid.Row="3" Grid.Column="0" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Load combo name:"></Label>
            <TextBox x:Name="textBoxLoadComboName" Grid.Column="1" Text="LC1" TextAlignment="Center"/>

        </Grid>

        <Grid Grid.Row="4" Grid.Column="0" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Load combo type:"></Label>
            <ComboBox Grid.Column="1" x:Name="comBoxLoadComboType" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ></ComboBox>

        </Grid>


        <Label Grid.Row="5" Grid.Column="0" Content="2. Load case(s) or combination(s) factor" FontSize="14" FontWeight="Bold"/>


        <Grid Grid.Row="6" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">Load case(s) or combination(s) factor:</Label>
            <TextBox Grid.Column="1" x:Name="textBoxLoadCaseFactor" Grid.Row="0" TextAlignment="Center" Text="1" InputScope="Number"/>
        </Grid>


        <Grid Grid.Row="7" Grid.Column="1" Margin="10 0 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="0.5*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="WrapWithOverflow" VerticalAlignment="Center">
        Available load case(s) or combination(s):
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="WrapWithOverflow" VerticalAlignment="Center">
        Selected load case(s) or combination(s):
            </TextBlock>

            <ListBox Grid.Row="1" Grid.Column="0" x:Name="listBoxAvailLoadCase" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Stretch" SelectionMode="Extended"></ListBox>

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10 0">
                <Button x:Name="buttonAddLoadCase" Content=">>" Click="buttonAddLoadCase_Click"></Button>
                <Button x:Name="buttonRemoveLoadCase" Content="&lt;&lt;" Click="buttonRemoveLoadCase_Click"></Button>
            </StackPanel>

            <ListBox Grid.Row="1" Grid.Column="2" x:Name="listBoxChoosenLoadCase" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Stretch" SelectionMode="Extended"></ListBox>

        </Grid>





        <Grid Grid.Row="9" Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Image Margin ="0 7 -70 7" HorizontalAlignment="Right" Source="/WS_SG_ETABS_Plugin;component/src/resources/by_Future_Design_Studio_no_powerapp.PNG" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
