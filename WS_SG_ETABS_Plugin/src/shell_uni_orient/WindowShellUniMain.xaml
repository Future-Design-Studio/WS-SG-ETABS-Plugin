<Window x:Class="WS_SG_ETABS_Plugin.src.shell_uni_orient.WindowShellUniMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.shell_uni_orient" 
             mc:Ignorable="d" Height="650" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Shell Direction (Local-3) Uniform" FontSize="28"/>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0 10 0 10">
            <Grid.ColumnDefinitions>                                             
                <ColumnDefinition Width="4*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Available Groups</Label>
                <ListBox x:Name="listBoxAvailGroup" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Stretch" SelectionMode="Multiple"></ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="buttonAdd" Content=">>" Click="buttonAdd_Click"></Button>
                <Button x:Name="buttonRemove" Content="&lt;&lt;" Click="buttonRemove_Click"></Button>
            </StackPanel>

            <DockPanel Grid.Column="2"  Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Selected Groups</Label>
                <ListBox x:Name="listBoxChoosenGroup" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Multiple"></ListBox>
            </DockPanel>

        </Grid>

        <Grid Grid.Row="2" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center">Make shells in selected group to face:</Label>
            <ComboBox Grid.Column="1" x:Name="comBoxShellDirection" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></ComboBox>
        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Justify"  
                   Margin="10 0 10 0" FontSize="10">Note:<LineBreak/>
                1. Choose group(s) to include in shell flip<LineBreak/>
                2. WARNING: This program does not bring ANY area assignment! (to be included in future updates)<LineBreak/>
<<<<<<< HEAD
                3. Press OK to proceed
=======
                3. Press OK to proceed<LineBreak/>
                4. Test
>>>>>>> master
        </TextBlock>

        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
            <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
        </StackPanel>




    </Grid>
</Window>
