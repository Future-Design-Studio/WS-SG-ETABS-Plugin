<Window x:Class="WS_SG_ETABS_Plugin.src.copy_properties.WindowCopyPropMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.copy_properties"
             mc:Ignorable="d" 
             Height="400" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="0.35*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="RC Beam Schedule" FontSize="28"/>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Margin="10 0 10 0" Content="ETABS file path"></Label>

            <Grid Grid.Column="2" Margin="0 10 0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <TextBox x:Name="filePath" Grid.Row="0" IsEnabled="False"></TextBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="buttonModifyPath" Content="Modify path" Width="100" Click="buttonModifyPath_Click"/>
                </StackPanel>

            </Grid>

        </Grid>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0 10 0 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.3*"></RowDefinition>
                <RowDefinition Height="0.3*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Property Definition"></Label>
                    <CheckBox Name="checkBoxMaterial" Content="Materials" Checked="checkBoxMaterial_Checked" Unchecked="checkBoxMaterial_Unchecked"></CheckBox>
                    <CheckBox Name="checkBoxFrameSec" Content="Frame section properties" IsEnabled="False"></CheckBox>
                    <CheckBox Name="checkBoxAreaSec" Content="Area section properties" IsEnabled="False"></CheckBox>
                    <CheckBox Name="checkBoxLinkSec" Content="Link section properties"></CheckBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Label Content="Miscellaneous"></Label>
                    <CheckBox Name="checkBoxMassSource" Content="Mass source"></CheckBox>
                    <CheckBox Name="checkBoxPDelta" Content="P-delta definition"></CheckBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Load Pattern Definition"></Label>
                    <CheckBox Name="checkBoxLoadPattern" Content="Load pattern"></CheckBox>
                    <CheckBox Name="checkBoxResponseSpectrum" Content="Response spectrum function"></CheckBox>
                    
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <Label Content="Load Case Definition"></Label>
                    <CheckBox Name="checkBoxLoadCase" Content="Load case" Checked="checkBoxLoadCase_Checked" Unchecked="checkBoxLoadCase_Unchecked"></CheckBox>
                    <CheckBox Name="checkBoxLoadCombination" Content="Load combination" IsEnabled="False"></CheckBox>
                </StackPanel>

            </Grid>

            <Label Grid.Row="1" Content="Note: Response spectrum will be converted to user function as ETABS is only able to import user function"></Label>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonUncheckAll" Content="Uncheck All" Width="100" Click="buttonUncheckAll_Click"/>
                <Button x:Name="buttonCheckAll" Content="Check All" Width="100" Click="buttonCheckAll_Click"/>
            </StackPanel>

        </Grid>


        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
            <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
        </StackPanel>

    </Grid>
</Window>
