<Window x:Class="WS_SG_ETABS_Plugin.src.carbon.WindowCarbonMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.carbon"
             mc:Ignorable="d" Height="650" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="2.6*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="ETABS Carbon Calculator" FontSize="28"/>

        <CheckBox x:Name="checkBoxAll" Grid.Row="1" Checked="checkBoxAll_Checked" Unchecked="checkBoxAll_Unchecked" VerticalAlignment="Center">Include all elements</CheckBox>
        
        <Grid Grid.Row="2" Grid.Column="0" Margin="0 10 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Available Groups</Label>
                <ListBox x:Name="listBoxAvailGroup" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Stretch" SelectionMode="Multiple"></ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="buttonAdd" Content=">>" Click="buttonAdd_Click"></Button>
                <Button x:Name="buttonRemove" Content="&lt;&lt;" Click="buttonRemove_Click"></Button>
            </StackPanel>

            <DockPanel Grid.Column="2"  Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Selected Groups</Label>
                <ListBox x:Name="listBoxChoosenGroup" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Multiple"></ListBox>
            </DockPanel>

        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Justify"  
                   Margin="10 0 10 0" FontSize="10">Note:<LineBreak/>
                1. Choose group(s) to include in carbon calculation (if all elements is not checked)<LineBreak/>
                2. Elements assigned in 2 groups will be counted TWICE (warning will be given)<LineBreak/>
                3. Does not seperate material for composite elements (ETABS does not seperate)<LineBreak/>
                4. Press OK to proceed
        </TextBlock>

        <Separator Grid.Row="3" VerticalAlignment="Bottom"/>

        <Grid Grid.Row="4" Margin="0 10 0 10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="1.1*"></ColumnDefinition>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
                <ColumnDefinition Width="0.7*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Column</Label>
            <Label Grid.Row="0" Grid.Column="1">Concrete grade: </Label>
            <ComboBox Grid.Row="0" Grid.Column="2" x:Name="comBoxColumnConcreteGrade"></ComboBox>
            <Label Grid.Row="0" Grid.Column="3">Rebar:</Label>
            <TextBox x:Name="textBoxColumnRebar" Grid.Row="0" Grid.Column="4">125</TextBox>
            <Label Grid.Row="0" Grid.Column="5">kg/m3</Label>

            <Label Grid.Row="1" Grid.Column="0">Beam</Label>
            <Label Grid.Row="1" Grid.Column="1">Concrete grade:</Label>
            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="comBoxBeamConcreteGrade"></ComboBox>
            <Label Grid.Row="1" Grid.Column="3">Rebar:</Label>
            <TextBox x:Name="textBoxBeamRebar" Grid.Row="1" Grid.Column="4">125</TextBox>
            <Label Grid.Row="1" Grid.Column="5">kg/m3</Label>

            <Label Grid.Row="2" Grid.Column="0">Brace</Label>
            <Label Grid.Row="2" Grid.Column="1">Concrete grade:</Label>
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="comBoxBraceConcreteGrade"></ComboBox>
            <Label Grid.Row="2" Grid.Column="3">Rebar:</Label>
            <TextBox x:Name="textBoxBraceRebar" Grid.Row="2" Grid.Column="4">125</TextBox>
            <Label Grid.Row="2" Grid.Column="5">kg/m3</Label>

            <Label Grid.Row="3" Grid.Column="0">Slab</Label>
            <Label Grid.Row="3" Grid.Column="1">Concrete grade:</Label>
            <ComboBox Grid.Row="3" Grid.Column="2" x:Name="comBoxFloorConcreteGrade"></ComboBox>
            <Label Grid.Row="3" Grid.Column="3">Rebar:</Label>
            <TextBox x:Name="textBoxFloorRebar" Grid.Row="3" Grid.Column="4">125</TextBox>
            <Label Grid.Row="3" Grid.Column="5">kg/m3</Label>

            <Label Grid.Row="4" Grid.Column="0">Wall</Label>
            <Label Grid.Row="4" Grid.Column="1">Concrete grade:</Label>
            <ComboBox Grid.Row="4" Grid.Column="2" x:Name="comBoxWallConcreteGrade"></ComboBox>
            <Label Grid.Row="4" Grid.Column="3">Rebar:</Label>
            <TextBox x:Name="textBoxWallRebar" Grid.Row="4" Grid.Column="4">125</TextBox>
            <Label Grid.Row="4" Grid.Column="5">kg/m3</Label>

        </Grid>



        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Image HorizontalAlignment="Left" Source="/WS_SG_ETABS_Plugin;component/src/resources/RambollFDSLogo.PNG" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>

        </Grid>




    </Grid>
</Window>
