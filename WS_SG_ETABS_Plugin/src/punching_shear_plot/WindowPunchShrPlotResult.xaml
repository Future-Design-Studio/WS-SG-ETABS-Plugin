<Window x:Class="WS_SG_ETABS_Plugin.src.punching_shear_plot.WindowPunchShrPlotResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.punching_shear_plot"
             mc:Ignorable="d" Height="1000" Width="1400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="140"></RowDefinition>
        </Grid.RowDefinitions>


        <WpfPlot Grid.Row="0" Name="ReactionPlot" />

        <Grid Grid.Row="1" Margin="0 10 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label FontSize="15" Content="Filter by group :" VerticalAlignment="Center"></Label>
        
            <ComboBox  Grid.Column="1" x:Name="comBoxGroupFilter" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5" InputScope="Digits" SelectionChanged="comBoxGroupFilter_SelectionChanged">
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2">
            <DataGrid Grid.Row="2" Name="dataGridGroupDefinitions" IsReadOnly="True" CanUserReorderColumns="False" Height="150"></DataGrid>
        </Grid>



    </Grid>
</Window>
