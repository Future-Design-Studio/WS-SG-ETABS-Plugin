<Window x:Class="WS_SG_ETABS_Plugin.src.etabs_to_rhino.WindowEtabsToRhinoMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.etabs_to_rhino"
             mc:Ignorable="d" Height="400" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2.5*"></RowDefinition>
            <RowDefinition Height="0.35*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Export to Rhino" FontSize="28"/>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="6*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Margin="0 0 10 0" Content=".3dm file path:"></Label>

                <TextBox x:Name="textBoxFilePath" Grid.Column="1" IsEnabled="False"></TextBox>

            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="6*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Margin="0 0 10 0" Content=".3dm file name:"></Label>

                <TextBox x:Name="textBoxFileName" Grid.Column="1"></TextBox>

            </Grid>

            <Grid Grid.Row="2">
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="buttonResetPath" Content="Reset path" Width="100" Click="buttonResetPath_Click"/>
                    <Button x:Name="buttonModifyPath" Content="Modify path" Width="100" Click="buttonModifyPath_Click"/>
                </StackPanel>
            </Grid>

        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Justify"  
                   FontSize="10">
                How to use:<LineBreak/>
                1. Adjust the output file path and name, then press the Export button to start the exporting process.<LineBreak/>
                2. A new .3dm file will be created in the given file path.<LineBreak/><LineBreak/>
                Note:<LineBreak/>
                1. The resulting .3dm file contains all frame and area objects available in the etabs model.<LineBreak/>
                2. Frame objects are represented as lines, with their properties attached as user string attributes.<LineBreak/>
                3. Area objects are represented as closed polylines, with their properties attached as user string attributes.<LineBreak/>
                4. The exporting process should take a few seconds to finish in most cases, but might take up to a few minutes depending on the size of the model. <LineBreak/>
                5. The resulting model units is in milimeters by default.<LineBreak/>
                <LineBreak/>

        </TextBlock>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Image Margin ="0 7 -180 7" HorizontalAlignment="Right" Source="/WS_SG_ETABS_Plugin;component/src/resources/by_Future_Design_Studio_no_powerapp.PNG" />
            </Grid>

            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                    <Button x:Name="buttonOk" Content="Export" Width="100" Click="buttonOk_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        
    </Grid>
</Window>
