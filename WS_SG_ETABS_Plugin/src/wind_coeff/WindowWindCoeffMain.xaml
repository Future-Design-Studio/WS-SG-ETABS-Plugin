<Window x:Class="WS_SG_ETABS_Plugin.src.wind_coeff.WindowWindCoeffMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.wind_coeff"
             mc:Ignorable="d" 
             Height="400" Width="800" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.Resources>
            <SolidColorBrush x:Key="brush" Color="Black"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.2*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Wind Coefficients Application" FontSize="28" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Group Name" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="1" Content="Load Pattern" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="2" Content="Direction" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="3" Content="Cp" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>

            
            <ComboBox  Grid.Row="1" Grid.Column="0" x:Name="comBoxGroups" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>


            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="comBoxLoadPattern" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>


            <ComboBox  Grid.Row="1" Grid.Column="2" x:Name="comBoxDirection" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>


            <TextBox Grid.Column="3" x:Name="textBoxCP" Grid.Row="1" IsEnabled="True" TextChanged="textBoxCP_TextChanged" TextAlignment="Center" VerticalContentAlignment="Center">0.65</TextBox>

            <Button Grid.Row="1" Grid.Column="4" Content="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="0,0,0,0" Click="Button_ADD_Wind_Click" ></Button>

            <ListBox x:Name="listBoxChoosenWind" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" 
                     d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Single"
                     Margin="0 0 0 0">
            </ListBox>

            <Button Grid.Row="2" Grid.Column="4" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="0,-150,0,0" Click="Button_REMOVE_Wind_Click" ></Button>

        </Grid>

        <Grid Grid.Row="2" Margin="0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Image Margin="0 2.5" HorizontalAlignment="Left" Source="/WS_SG_ETABS_Plugin;component/src/resources/RambollFDSLogo.PNG" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
