<Window x:Class="WS_SG_ETABS_Plugin.src.wall_design_view.WindowWallDesignResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.wall_design_view"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="0.15*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <WpfPlot Grid.Column ="0" Name="ResultPlot" />

        <Grid Grid.Column="1" Margin="0 0 10 0">
            <StackPanel>
                <Label FontSize="22" FontWeight="Bold">View Control</Label>

                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">Group to plot:</Label>
                <ComboBox Grid.Column="1" x:Name="comBoxGroup" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          SelectionChanged="comBoxGroup_SelectionChanged"  FontSize="12"></ComboBox>
                <Label></Label>

                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">View Type:</Label>
                <ComboBox Grid.Column="1" x:Name="comBoxViewType" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          SelectionChanged="comBoxTypeOfFailure_SelectionChanged"  FontSize="12"></ComboBox>
                <Label></Label>
                
                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">Filter failure:</Label>
                <CheckBox Name="checkBoxShowOk" FontSize="16" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowOk_Click">Pass</CheckBox>
                <CheckBox Name="checkBoxShowFail" FontSize="16" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowFail_Click">Fail</CheckBox>
                <CheckBox Name="checkBoxShowNull" FontSize="16" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowNull_Click">Null</CheckBox>
                <Label></Label>

                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">Wall type:</Label>
                <CheckBox Name="checkBoxShowPier" FontSize="16" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowPier_Click">Pier</CheckBox>
                <CheckBox Name="checkBoxShowSpandrel" FontSize="16" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowSpandrel_Click">Spandrel</CheckBox>
                <Label></Label>

                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">Reinforcement color bar:</Label>
                
                <DockPanel>
                    <Label Grid.Column="0" VerticalAlignment="Center" FontSize="16">Max reinf %:</Label>
                    <TextBox Name="textBoxMaxReinf" FontSize="16" TextChanged="textBoxMaxReinf_TextChanged">4</TextBox>
                </DockPanel>

                <DockPanel>
                    <Label Grid.Column="0" VerticalAlignment="Center" FontSize="16" Margin="0 0 3 0">Min reinf %:</Label>
                    <TextBox Name="textBoxMinReinf" FontSize="16" TextChanged="textBoxMinReinf_TextChanged">0</TextBox>
                </DockPanel>


                <Label></Label>

                <Label Grid.Column="0" VerticalAlignment="Center" FontSize="20">Plan view:</Label>
                <WpfPlot Grid.Column ="0" Name="PlanViewPlot" Margin="-20 0 0 0"/>
            </StackPanel>


        </Grid>
        

    </Grid>
</Window>
