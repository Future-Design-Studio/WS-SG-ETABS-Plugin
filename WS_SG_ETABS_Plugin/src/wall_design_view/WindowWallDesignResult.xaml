<Window x:Class="WS_SG_ETABS_Plugin.src.wall_design_view.WindowWallDesignResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.wall_design_view"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="0.1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <WpfPlot Grid.Column ="0" Name="ResultPlot" />

        <Grid Grid.Column="1">
            <StackPanel>
                <Label FontSize="22" FontWeight="Bold">View Control</Label>
                <CheckBox Name="checkBoxShowOk" FontSize="20" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowOk_Click">Pass</CheckBox>
                <CheckBox Name="checkBoxShowFail" FontSize="20" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowFail_Click">Fail</CheckBox>
                <CheckBox Name="checkBoxShowNull" FontSize="20" VerticalContentAlignment="Center" IsChecked="True" Click="checkBoxShowNull_Click">Null</CheckBox>
            </StackPanel>


        </Grid>
        

    </Grid>
</Window>
