<Window x:Class="WS_SG_ETABS_Plugin.src.plot_reaction.WindowPlotReactionMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.plot_reaction"
            xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" Height="900" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="5.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Plot Reaction" FontSize="28"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Title:"></Label>
            <TextBox Grid.Column="1" x:Name="textBoxTitle" Grid.Row="0" TextAlignment="Left"/>
            
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0 10 0 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="6*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Group"/>
            <Label Grid.Row="0" Grid.Column="1" Content="Color"/>

            <ComboBox  Grid.Row="1" Grid.Column="0" x:Name="comBoxGroup" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5" InputScope="Digits">
            </ComboBox>

            <xctk:ColorPicker Grid.Row="1" Grid.Column="1" Name="ClrPcker" 
                              SelectedColorChanged="ClrPcker_SelectedColorChanged"
                              Margin="5 0 5 0" IsEnabled="False">
            </xctk:ColorPicker>

            <CheckBox x:Name="checkBoxDefault" Grid.Row="2" Grid.Column="1"  Grid.ColumnSpan="2"
                      Checked="checkBoxDefault_Checked" Unchecked="checkBoxDefault_UnChecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True">
                Use default color and opacity
            </CheckBox>

            <Label Grid.Row="3" Grid.Column="0" Content="Selected groups:"/>

            <ListBox x:Name="listBoxChoosenGroup" Grid.Row="4" Grid.ColumnSpan="2" 
                     d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Single"
                     Margin="0 10 0 10">
            </ListBox>

            <Button x:Name="buttonRemove" Grid.Row="5" Grid.Column="0" 
                    Content="Remove" Click="buttonRemove_Click"></Button>

            <Button x:Name="buttonAdd" Grid.Row="5" Grid.Column="1" 
                    Content="Add" Click="buttonAdd_Click"></Button>

            <!--
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <DockPanel Grid.Column="0" Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Available Groups</Label>
                <ListBox x:Name="listBoxAvailGroup" d:ItemsSource="{d:SampleData ItemCount=5}" VerticalAlignment="Stretch" SelectionMode="Multiple"></ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="buttonAdd" Content=">>" Click="buttonAdd_Click"></Button>
                <Button x:Name="buttonRemove" Content="&lt;&lt;" Click="buttonRemove_Click"></Button>
            </StackPanel>

            <DockPanel Grid.Column="2"  Margin="10 0 10 0">
                <Label DockPanel.Dock="Top">Selected Groups</Label>
                <ListBox x:Name="listBoxChoosenGroup" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Multiple"></ListBox>
            </DockPanel>

            <xctk:ColorPicker Name="ClrPcker_Background" SelectedColorChanged="ClrPcker_Background_SelectedColorChanged"></xctk:ColorPicker>
            -->
        </Grid>

        <Grid Grid.Row="3" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center">Load case or load combination to plot:</Label>
            <ComboBox Grid.Column="1" x:Name="comBoxOutputCase" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></ComboBox>
        </Grid>

        <Grid Grid.Row="4" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">Reaction force or moment direction to plot:</Label>
            <ComboBox Grid.Column="1" x:Name="comBoxReactionDirection" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></ComboBox>
        </Grid>

        <Grid Grid.Row="5" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">Force factor (if factor = 1, plot is in kN):</Label>
            <TextBox Grid.Column="1" x:Name="textBoxForceFactor" Grid.Row="0" TextAlignment="Center" Text="1" InputScope="Digits"/>
        </Grid>

        <Grid Grid.Row="6" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">Bubble scale factor:</Label>
            <TextBox Grid.Column="1" x:Name="textBoxBubbleScaleFactor" Grid.Row="0" TextAlignment="Center" Text="0.01" InputScope="Digits"/>
        </Grid>

        <Grid Grid.Row="7" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">Text size:</Label>
            <TextBox Grid.Column="1" x:Name="textBoxTextSize" Grid.Row="0" TextAlignment="Center" Text="12" InputScope="Number"/>
        </Grid>

        <Grid Grid.Row="8" Margin="10 10 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="4*"></RowDefinition>
            </Grid.RowDefinitions>

            <CheckBox x:Name="checkBoxSum" Checked="checkBoxSum_Checked" Unchecked="checkBoxSum_Unchecked">Show sum of reactions</CheckBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <RadioButton x:Name="radioButtonSplitX" Grid.Column="0" GroupName="radioSum" IsEnabled="False" Checked="radioButtonSplitX_Checked" Unchecked="radioButtonSplitX_Unchecked">
                    Split X axis
                </RadioButton>
                <RadioButton x:Name="radioButtonSplitY" Grid.Column="1" GroupName="radioSum" IsEnabled="False" Checked="radioButtonSplitY_Checked" Unchecked="radioButtonSplitY_Unchecked">
                    Split Y axis
                </RadioButton>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Division of X axis:"></Label>
                    <Label Grid.Column="0" Grid.Row="1" Content="Offset of sum label in Y (m):"></Label>
                    <Label Grid.Column="0" Grid.Row="2" Content="Total text size:"></Label>
                    <Label Grid.Column="0" Grid.Row="3" Content="Separation each group label in Y (m):"></Label>

                    <TextBox x:Name="textBoxDivisionX" Grid.Column="1" Grid.Row="0" IsEnabled="False" InputScope="Number" Text="4"></TextBox>
                    <TextBox x:Name="textBoxOffsetX" Grid.Column="1" Grid.Row="1" IsEnabled="False" InputScope="Number" Text="10"></TextBox>
                    <TextBox x:Name="textBoxSumTextSizeX" Grid.Column="1" Grid.Row="2" IsEnabled="False" InputScope="Number" Text="20"></TextBox>
                    <TextBox x:Name="textBoxSeparationX" Grid.Column="1" Grid.Row="3" IsEnabled="False" InputScope="Number" Text="8"></TextBox>

                </Grid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="Division of Y axis:"></Label>
                    <Label Grid.Column="0" Grid.Row="1" Content="Offset of sum label in X (m):"></Label>
                    <Label Grid.Column="0" Grid.Row="2" Content="Total text size:"></Label>
                    <Label Grid.Column="0" Grid.Row="3" Content="Separation each group label in Y (m):"></Label>

                    <TextBox x:Name="textBoxDivisionY" Grid.Column="1" Grid.Row="0" IsEnabled="False" InputScope="Number" Text="4"></TextBox>
                    <TextBox x:Name="textBoxOffsetY" Grid.Column="1" Grid.Row="1" IsEnabled="False" InputScope="Number" Text="10"></TextBox>
                    <TextBox x:Name="textBoxSumTextSizeY" Grid.Column="1" Grid.Row="2" IsEnabled="False" InputScope="Number" Text="20"></TextBox>
                    <TextBox x:Name="textBoxSeparationY" Grid.Column="1" Grid.Row="3" IsEnabled="False" InputScope="Number" Text="8"></TextBox>

                </Grid>
            </Grid>
        </Grid>
        
        <TextBlock Grid.Row="9" Grid.Column="0" TextWrapping="Wrap" TextAlignment="Justify"  
                       Margin="10 0 10 0" FontSize="10">Note:<LineBreak/>
                    1. Choose load case or load combination to include in plot<LineBreak/>
                    2. Choose group(s) to include in plot<LineBreak/>
                    3. Press OK to proceed
        </TextBlock>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
            <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
        </StackPanel>

    </Grid>

</Window>
