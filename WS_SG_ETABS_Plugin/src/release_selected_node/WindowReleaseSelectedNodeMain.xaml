<Window x:Class="WS_SG_ETABS_Plugin.src.release_selected_node.WindowReleaseSelectedNodeMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.release_selected_node"
             mc:Ignorable="d" 
             Height="700" Width="1200" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.Resources>
            <SolidColorBrush x:Key="brush" Color="Black"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.12*"></RowDefinition>
            <RowDefinition Height="0.1*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Frame End Release Application" FontSize="28" Grid.ColumnSpan="2"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Group name of Frames to release" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="1" Content="Group name of Joints to release at" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="2" Content="Release" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>


            <ComboBox  Grid.Row="1" Grid.Column="0" x:Name="comBoxGroupsFrames"  Grid.RowSpan="1" Margin="0 10"
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>


            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="comBoxGroupsJoints" Grid.RowSpan="1" Margin="0 10"
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Content="Axial Load" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>
                <Label Grid.Column="1" Content="Shear Force 2 (Major)" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>
                <Label Grid.Column="2" Content="Shear Force 2 (Minor)" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>
                <Label Grid.Column="3" Content="Torsion" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>
                <Label Grid.Column="4" Content="Moment 22 (Minor)" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>
                <Label Grid.Column="5" Content="Moment 33 (Major)" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" FontSize="9"/>

                <CheckBox x:Name="checkBoxAxial" Grid.Row="1" Grid.Column="0"
                      Checked="checkBoxAxial_Checked" Unchecked="checkBoxAxial_Unchecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True">
                </CheckBox>

                <CheckBox x:Name="checkBoxShearMajor" Grid.Row="1" Grid.Column="1"
                      Checked="checkBoxShearMajor_Checked" Unchecked="checkBoxShearMajor_Unchecked" 
                      VerticalAlignment="Bottom" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True" Margin="0,0,0,8">
                </CheckBox>

                <CheckBox x:Name="checkBoxShearMinor" Grid.Row="1" Grid.Column="2"
                      Checked="checkBoxShearMinor_Checked" Unchecked="checkBoxShearMinor_Unchecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True">
                </CheckBox>

                <CheckBox x:Name="checkBoxTorsion" Grid.Row="1" Grid.Column="3"
                      Checked="checkBoxTorsion_Checked" Unchecked="checkBoxTorsion_Unchecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True">
                </CheckBox>

                <CheckBox x:Name="checkBoxMomentMinor" Grid.Row="1" Grid.Column="4"
                      Checked="checkBoxMomentMinor_Checked" Unchecked="checkBoxMomentMinor_Unchecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True">
                </CheckBox>

                <CheckBox x:Name="checkBoxMomentMajor" Grid.Row="1" Grid.Column="5"
                      Checked="checkBoxMomentMajor_Checked" Unchecked="checkBoxMomentMajor_Unchecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False" IsEnabled="True">
                </CheckBox>
            </Grid>

            <Button Grid.Row="1" Grid.Column="3" Content="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="0,0,0,0" Click="Button_ADD_Releases_Click" ></Button>

            <ListBox x:Name="listBoxChoosenReleases" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" 
                     d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Single"
                     Margin="0 0 0 0">
            </ListBox>

            <Button Grid.Row="2" Grid.Column="3" Content="Remove" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Button_REMOVE_Releases_Click" />

        </Grid>

        <Grid Grid.Row="3" Margin="0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Image Margin ="0 7 -380 7" HorizontalAlignment="Right" Source="/WS_SG_ETABS_Plugin;component/src/resources/by_Future_Design_Studio_no_powerapp.PNG" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Notes" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Label Grid.Row="1" Grid.Column="0" Content="1) Using this plugin will replace the end releases in the group of frames selected." VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>

    </Grid>
</Window>
