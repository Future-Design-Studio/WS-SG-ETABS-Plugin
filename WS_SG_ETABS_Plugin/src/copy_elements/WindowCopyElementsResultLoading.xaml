<Window x:Class="WS_SG_ETABS_Plugin.src.copy_elements.WindowCopyElementsResultLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.copy_elements"
             mc:Ignorable="d" Height="250" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="2.2*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Margin="0 -10 0 0" Content="Copy Elements" FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="0" Margin="0 -10 0 0" Content="Processing model..." FontSize="12"/>

        <ProgressBar Grid.Row="2" Grid.Column="0" Margin="0 3 0 3" IsIndeterminate="True"></ProgressBar>

        <Grid Grid.Row="3" Grid.Column="0" Margin=" 0 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0" Name="checkBoxExtractTable" Content="Extracting database table from ETABS" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="0" Name="checkBoxProcessConnectivity" Content="Processing elements connectivity" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="2" Grid.Column="0" Name="checkBoxProcessGroupName" Content="Processing elements group name" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="3" Grid.Column="0" Name="checkBoxCreateGroups" Content="Creating groups in ETABS" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="4" Grid.Column="0" Name="checkBoxCreateElements" Content="Creating elements in ETABS" IsEnabled="False" IsChecked="False"></CheckBox>
            <ProgressBar Grid.Row="5" Grid.Column="0" Margin="0 3 0 3" Name="progressBarCreateElements"></ProgressBar>

        </Grid>


    </Grid>
</Window>
