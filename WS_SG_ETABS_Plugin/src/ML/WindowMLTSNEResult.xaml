<Window x:Class="WS_SG_ETABS_Plugin.src.ML.WindowMLTSNEResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.rc_beam_schedule"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <WpfPlot Grid.Column="0" Name="TSNEPlot" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WpfPlot Grid.Row="0" Name="FeaturesPlot" />

            <ListBox Grid.Row="1" Grid.Column="0" x:Name="listBoxCluster" d:ItemsSource="{d:SampleData ItemCount=5}" 
                    VerticalAlignment="Stretch" SelectionMode="Extended" SelectionChanged="listBoxCluster_SelectionChanged"
                    Margin="10"></ListBox>
        </Grid>

    </Grid>
</Window>
