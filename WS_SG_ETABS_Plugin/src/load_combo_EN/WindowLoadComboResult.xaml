<Window x:Class="WS_SG_ETABS_Plugin.src.load_combo_EN.WindowLoadComboResult"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.load_combo_EN"
             mc:Ignorable="d" Height="120" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Label VerticalAlignment="Center" HorizontalAlignment="Center">Plugin completed successfully.</Label>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" Margin="0 10 0 10">
            <Button x:Name="buttonOk" Content="OK" Width="50" Click="buttonOk_Click"/>
        </Grid>

    </Grid>
</Window>
