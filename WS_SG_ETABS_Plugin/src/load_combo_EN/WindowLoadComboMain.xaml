<Window x:Class="WS_SG_ETABS_Plugin.src.load_combo_EN.WindowLoadComboMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.load_combo_EN"
             mc:Ignorable="d" Height="2400" Width="1920" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.4*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Load Pattern and Load Case Definition" FontSize="28"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Grid.Column="2" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Content="Gk" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Dead Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameDL" Grid.Row="1"></TextBox>

            <Button Grid.Row="1" Grid.Column="3" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenDL" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" 
                     d:ItemsSource="{d:SampleData ItemCount=1}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenGroup_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="3" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Grid.Column="2" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Content="Gk" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Superimposed Dead Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameSDL" Grid.Row="1"></TextBox>

            <Button Grid.Row="1" Grid.Column="3" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenSDL" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" 
                     d:ItemsSource="{d:SampleData ItemCount=4}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenSDL_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="3" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Grid.Column="2" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="3" Content="Category for ψ factor" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Content="Qk" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Live Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameLL" Grid.Row="1"></TextBox>

            <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="comBoxLL" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5" SelectionChanged="comBoxLL_SelectionChanged"></ComboBox>

            <Button Grid.Row="1" Grid.Column="4" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenLL" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="5" 
                     d:ItemsSource="{d:SampleData ItemCount=10}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenLL_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="4" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.35*"></RowDefinition>
                <RowDefinition Height="0.35*"></RowDefinition>
                <RowDefinition Height="0.35*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.35*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Grid.Column="2" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="3" Content="Category for ψ factor" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="4" Content="Consider +/- ?" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="5" Content="Number of Directions" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Content="Qk" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.RowSpan="2"/>
            <Label Grid.Row="1" Grid.Column="1" Content="Wind Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Row="2" Grid.Column="1" Content="Wind Vertical Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameWIND" Grid.Row="1"></TextBox>
            <TextBox Grid.Column="2" x:Name="textBoxNameWINDVERTICAL" Grid.Row="2"></TextBox>

            <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="comBoxWIND" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>
            <ComboBox  Grid.Row="2" Grid.Column="3" x:Name="comBoxWINDVERTICAL" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>

            <CheckBox x:Name="checkBoxWIND" Grid.Row="1" Grid.Column="4"  Grid.ColumnSpan="1"
                      Checked="checkBoxWIND_Checked" Unchecked="checkBoxWIND_UnChecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False">
            </CheckBox>
            <CheckBox x:Name="checkBoxWINDVERTICAL" Grid.Row="2" Grid.Column="4"  Grid.ColumnSpan="1"
                      Checked="checkBoxWINDVERTICAL_Checked" Unchecked="checkBoxWINDVERTICAL_UnChecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False">
            </CheckBox>

            <ComboBox  Grid.Row="1" Grid.Column="5" x:Name="comBoxWINDDIRECTION" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>

            <Button Grid.Row="1" Grid.Column="6" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>
            <Button Grid.Row="2" Grid.Column="6" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenWIND" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="7" 
                     d:ItemsSource="{d:SampleData ItemCount=10}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenWIND_SelectionChanged">
            </ListBox>

            <Button Grid.Row="4" Grid.Column="6" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="1" Content="Notional Factor" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Notional Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameNOTIONALFACTOR" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" >0.015</TextBox>

            <ListBox x:Name="listBoxChoosenNOTIONAL" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="5" 
                     d:ItemsSource="{d:SampleData ItemCount=10}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenNOTIONAL_SelectionChanged">
            </ListBox>


        </Grid>






        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>
            <Label Grid.Column="2" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="3" Content="Category for ψ factor" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="4" Content="Consider +/- ?" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="1" Content="Temperature Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Qk" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="2" x:Name="textBoxNameTEMP" Grid.Row="1"></TextBox>

            <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="comBoxTEMP" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5"></ComboBox>

            <CheckBox x:Name="checkBoxTEMP" Grid.Row="1" Grid.Column="4"  Grid.ColumnSpan="1"
                      Checked="checkBoxTEMP_Checked" Unchecked="checkBoxTEMP_UnChecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False">
            </CheckBox>

            <Button Grid.Row="1" Grid.Column="5" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenTEMP" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="6" 
                     d:ItemsSource="{d:SampleData ItemCount=2}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenTEMP_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="5" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="7">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Seismic Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Grid.Row="1" Grid.Column="5" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenSEISMIC" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" 
                     d:ItemsSource="{d:SampleData ItemCount=3}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenSEISMIC_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="1" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>
            <Label Grid.Column="1" Content="Load Pattern Name" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="2" Content="Consider +/- ?" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Accidental Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="1" x:Name="textBoxNameAL" Grid.Row="1"></TextBox>

            <CheckBox x:Name="checkBoxAL" Grid.Row="1" Grid.Column="2"  Grid.ColumnSpan="1"
                      Checked="checkBoxAL_Checked" Unchecked="checkBoxAL_UnChecked" 
                      VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="False">
            </CheckBox>

            <Button Grid.Row="1" Grid.Column="3" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenAL" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="4" 
                     d:ItemsSource="{d:SampleData ItemCount=4}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenAL_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="3" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="9">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Uplift Load" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Grid.Row="1" Grid.Column="5" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenUPLIFT" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" 
                     d:ItemsSource="{d:SampleData ItemCount=1}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenUPLIFT_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="1" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="0.4*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Content="Load Pattern Type" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Label Grid.Column="1" Content="EHF Factor" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Equivalent Horizontal Force" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBox Grid.Column="1" x:Name="textBoxNameEHF" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" >0.005</TextBox>

            <Button Grid.Row="1" Grid.Column="2" Content="ADD" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

            <ListBox x:Name="listBoxChoosenEHF" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="5" 
                     d:ItemsSource="{d:SampleData ItemCount=30}" SelectionMode="Single"
                     Margin="0 10 0 10" SelectionChanged="listBoxChoosenEHF_SelectionChanged">
            </ListBox>

            <Button Grid.Row="3" Grid.Column="2" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="21,0,0,0" ></Button>

        </Grid>






        <Grid Grid.Row="11">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Notes" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Label Grid.Row="1" Grid.Column="0" Content="1) For Seismic, please manually input the response spectrum. From the Load Case created through this plugin, please edit from there instead of creating a new load case so that load combinations will not be affected." VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Label Grid.Row="2" Grid.Column="0" Content="2) Wind Load is also created as other load for now for simplicity. Please change the load pattern as required to input proper wind factors if you would like to use diaphragm or shell extents for wind load application." VerticalAlignment="Center" HorizontalAlignment="Left"/>
        </Grid>






        <Grid Grid.Row="12">
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>
        </Grid>






    </Grid>






</Window>
