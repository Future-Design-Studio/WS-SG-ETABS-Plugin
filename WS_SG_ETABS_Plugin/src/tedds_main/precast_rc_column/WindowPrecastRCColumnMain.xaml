<Window x:Class="WS_SG_ETABS_Plugin.src.tedds_main.precast_rc_column.WindowPrecastRCColumnMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.tedds_main.precast_rc_column"
             mc:Ignorable="d"    Height="440" Width="1000" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Precast concrete column design (EN1992)" FontSize="28"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="0.4*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="0.2*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>


            <!-- Column 0 -->
            <Label Grid.Column="0" Grid.Row="0" Content="Groups of columns" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <ComboBox  Grid.Row="1" Grid.Column="0" x:Name="comBoxGroup" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="0.5" SelectionChanged="comBoxGroup_SelectionChanged"></ComboBox>

            <ListBox x:Name="listBoxGroups" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3"
                     d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Single"
                     Margin="0 0 0 0" SelectionChanged="listBoxGroups_SelectionChanged">
            </ListBox>


            <!-- Column 1 -->
            <Label Grid.Column="1" Grid.Row="0" Content="Cover (mm)" VerticalAlignment="Center" HorizontalAlignment="Center" ForceCursor="True"/>
            
            <TextBox  Grid.Row="1" Grid.Column="1" x:Name="textboxCover" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="35" TextChanged="textboxCover_TextChanged" InputScope="Number"></TextBox>


            <!-- Column 2 -->
            <Label Grid.Column="2" Grid.Row="0" Content="Concrete Grade" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <ComboBox  Grid.Row="1" Grid.Column="2" x:Name="comboxConcreteGrade" 
                       VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                       Text="35" SelectionChanged="comboxConcreteGrade_SelectionChanged"></ComboBox>


            <!-- Column 3 -->
            <Button Grid.Row="3" Grid.Column="3" Content="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="0,-150,0,0" Click="Button_ADD_Case_Pattern_Click" Name="Button_ADD_Case_Pattern" ></Button>

            <Button Grid.Row="3" Grid.Column="3" Content="Remove" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="1" Margin="0,-90,0,0" Click="Button_REMOVE_Case_Pattern_Click" ></Button>
        </Grid>








        <!-- Logo and ok/cancel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Image Margin ="0 4 -90 4" HorizontalAlignment="Right" Source="/WS_SG_ETABS_Plugin;component/src/resources/by_Future_Design_Studio_no_powerapp.PNG" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" Click="buttonCancel_Click"/>
                <Button x:Name="buttonOk" Content="OK" Width="100" Click="buttonOk_Click"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
