<Window x:Class="WS_SG_ETABS_Plugin.src.tedds_main.precast_rc_column.WindowPrecastRCColumnLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.tedds_main.precast_rc_column"
             mc:Ignorable="d"    Height="250" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.8*"></RowDefinition>
            <RowDefinition Height="0.8*"></RowDefinition>
            <RowDefinition Height="3.8*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Margin="0 -10 0 0" Content="Precast concrete column design (EN1992)" FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="0" Margin="0 -10 0 0" Content="Loading ETABS database table..." FontSize="12"/>

        <ProgressBar Grid.Row="2" Grid.Column="0" Margin="0 3 0 3" IsIndeterminate="True"></ProgressBar>

        <Grid Grid.Row="3" Grid.Column="0" Margin=" 0 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="0" Name="checkBoxColumnObjectConnectivity" Content="Column Object Connectivity" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="0" Name="checkBoxConcreteColumnOverwrites" Content="Concrete Column Overwrites" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="2" Grid.Column="0" Name="checkBoxSConcreteColumnPMMEnvelope" Content="Concrete Column PMM Envelope" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="3" Grid.Column="0" Name="checkBoxFrameAssignmentsSectionProperties" Content="Frame Assignments - Section Properties" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="4" Grid.Column="0" Name="checkBoxFrameSectionPropertyDefinitionsConcreteCircle" Content="Frame Section Property Definitions - Concrete Circle" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="5" Grid.Column="0" Name="checkBoxFrameSectionPropertyDefinitionsConcreteRectangular" Content="Frame Section Property Definitions - Concrete Rectangular" IsEnabled="False" IsChecked="False" ></CheckBox>
            <CheckBox Grid.Row="6" Grid.Column="0" Name="checkBoxGroupAssignments" Content="Group Assignments" IsEnabled="False" IsChecked="False" ></CheckBox>


        </Grid>


    </Grid>
</Window>
