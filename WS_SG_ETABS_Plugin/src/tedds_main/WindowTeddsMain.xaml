<Window x:Class="WS_SG_ETABS_Plugin.src.tedds_main.WindowTeddsMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.tedds_main"
             mc:Ignorable="d"  Height="550" Width="1700" Closed="WindowMain_Closed" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10 0 10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.8*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <Image Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="5" Source="/WS_SG_ETABS_Plugin;component/src/resources/TEDDS_by_Future_Design_Studio.png"/>

        <!-- Labels -->
        <Label Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >Available</Label>
        <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" ></Label>
        <Label Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" ></Label>
        <Label Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >Upcoming</Label>

        <!-- 1 -->
        <Button Grid.Row="3" x:Name="buttonPrecastSplice" Content="Precast concrete column design (EN1992) (Beta Version)" FontSize="16" Click="buttonPrecastSplice_Click"/>

        <!-- 2 -->


        <!-- 3 -->


        <!-- 4 -->
        <Button Grid.Row="3" Grid.Column="3" x:Name="buttonPadFooting" Content="Foundation analysis and design (EN1992/EN1997)" FontSize="16" Click="buttonPadFooting_Click" IsEnabled="False"/>






        <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" x:Name="buttonFeedback" Content="Feedback" FontSize="12" Margin="290 10 0 0" Click="buttonFeedback_Click" IsEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" x:Name="buttonHelper" Content="Help" FontSize="12" Margin="0 10 0 0" Click="buttonHelper_Click" IsEnabled="True" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Image Grid.Row="99" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="2" HorizontalAlignment="Left" Margin="11" Source="/WS_SG_ETABS_Plugin;component/src/resources/RambollFDSLogo.png"/>
        <Label Grid.Row="99" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Name="labelVersion" ></Label>
    </Grid>
</Window>
