<Window x:Class="WS_SG_ETABS_Plugin.src.joint_forces_extractor.WindowJointForceExtractorLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.joint_forces_extractor"
             mc:Ignorable="d" Height="150" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Margin="0 -10 0 0" Content="Joint Force Extractor" FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="0" Margin="0 -10 0 0" Content="Loading ETABS database table..." FontSize="12"/>

        <ProgressBar Grid.Row="2" Grid.Column="0" Margin="0 3 0 3" IsIndeterminate="True"></ProgressBar>

        <Grid Grid.Row="3" Grid.Column="0" Margin=" 0 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <CheckBox Name="checkBoxJointForcesFrames" Content="Element Joint Forces - Frame" IsEnabled="False" IsChecked="False"></CheckBox>


        </Grid>


    </Grid>
</Window>
