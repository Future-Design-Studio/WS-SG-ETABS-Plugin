<Window x:Class="WS_SG_ETABS_Plugin.WindowMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src"
             mc:Ignorable="d" Height="600" Width="1700" Closed="WindowMain_Closed" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Name="WindowMainz">
    <Grid Margin="10 0 10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.8*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <Image Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="2" Margin="5" Source="/WS_SG_ETABS_Plugin;component/src/resources/by_Future_Design_Studio.png"/>

        <!-- Labels -->
        <Label Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >Wide Use Case</Label>
        <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >Specific Use Case</Label>
        <Label Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >Upcoming</Label>
        <Label Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="ExtraBold" >FDS Only</Label>
        
        <!-- Wide Use Case -->
        <Button Grid.Row="3" x:Name="buttonRCBeamSchedule" Content="RC Beam Schedule (Beta Version)" FontSize="16" Click="buttonRCBeamSchedule_Click"/>
        <Button Grid.Row="4" x:Name="buttonCopyProperties" Content="Importing ETABS Properties (Beta Version)" FontSize="16" Click="buttonCopyProperties_Click"/>
        <Button Grid.Row="5" x:Name="buttonPlotReaction" Content="Export Joint Reactions (Beta Version)" FontSize="16" Click="buttonPlotReaction_Click"/>
        <Button Grid.Row="6" x:Name="buttonLoadCombo" Content="Load Combination EN (Beta Version)" FontSize="16" Click="buttonLoadCombo_Click"/>
        <Button Grid.Row="7" Grid.Column="0" x:Name="buttonPadFooting" Content="Pad Footing Design (Beta Version)" Click="buttonPadFooting_Click" FontSize="16"/>
        <Button Grid.Row="8" Grid.Column="0" x:Name="buttonPunchingShear" Content="Punching Shear Force Plot (Beta Version)" Click="buttonPunchingShear_Click" FontSize="16"/>
        <Button Grid.Row="9" Grid.Column="0" x:Name="buttonTedds" Content="TEDDS PowerApp (Beta Version)" Click="buttonTrfTedds_Click" FontSize="16"/>
        <Button Grid.Row="10" Grid.Column="0" x:Name="buttonRCColSchedule" Content="RC Column Schedule (Beta Version)" Click="buttonRCColSchedule_Click" FontSize="16"/>
        <Button Grid.Row="11" Grid.Column="0" x:Name="buttonPlotDrift" Content="Plot Drift (Beta Version)" Click="buttonPlotDrift_Click" FontSize="16"/>
        <Button Grid.Row="12" Grid.Column="0" x:Name="buttonPlotSumMassParticip" Content="Plot Sum Mass Participation (Beta Version)" Click="buttonPlotSumMassParticip_Click" FontSize="16"/>
        <Button Grid.Row="13" Grid.Column="0" x:Name="buttonWallDesignViewer" Content="Wall Design Viewer (Beta Version)" Click="buttonWallDesignViewer_Click" FontSize="16"/>
        
        <!-- Specific Use Case -->
        <Button Grid.Row="3" Grid.Column="1" x:Name="buttonShellUni" Content="Shell Orientation (Local-3) (Beta Version)" FontSize="16" Click="buttonShellUni_Click" IsEnabled="True"/>
        <Button Grid.Row="4" Grid.Column="1" x:Name="buttonSelUniqueName" Content="Select by Unique Name (Beta Version)" FontSize="16" Click="buttonSelUniqueName_Click" IsEnabled="True"/>
        <Button Grid.Row="5" Grid.Column="1" x:Name="buttonEtabsToRhino" Content="Export To Rhino (Beta Version)" FontSize="16" Click="buttonEtabsToRhino_Click" IsEnabled="True"/>
        <Button Grid.Row="6" Grid.Column="1" x:Name="buttonWindCoeff" Content="Wind Coefficient Applications (Beta Version)" FontSize="16" Click="buttonWindCoeff_Click" IsEnabled="True"/>
        <Button Grid.Row="7" Grid.Column="1" x:Name="buttonReleaseSelectedNode" Content="Release Frames at Specific Nodes (Beta Version)" FontSize="16" Click="buttonReleaseSelectedNode_Click" IsEnabled="True"/>
        <Button Grid.Row="8" Grid.Column="1" x:Name="buttonTrfEtabsLoads" Content="Transfer Joint Reaction as Load Applied (Beta Version)" Click="buttonTrfEtabsLoads_Click" FontSize="16" IsEnabled="True"/>
        <Button Grid.Row="9" Grid.Column="1" x:Name="buttonTrfEtabstoSafe" Content="Transfer ETABS Reaction to SAFE (Beta Version)" Click="buttonTrfEtabstoSafe_Click" FontSize="16" IsEnabled="True"/>
        <Button Grid.Row="10" Grid.Column="1" x:Name="buttonAddLoadCombo" Content="Add Load Combo (Beta Version)" Click="buttonAddLoadCombo_Click" FontSize="16" IsEnabled="True"/>
        <Button Grid.Row="11" Grid.Column="1" x:Name="buttonApplyModifier" Content="Apply Element Modifier (Beta Version)" Click="buttonApplyModifier_Click" FontSize="16" IsEnabled="True"/>
        <Button Grid.Row="12" Grid.Column="1" x:Name="buttonApplySectProp" Content="Apply Section Property (Beta Version)" Click="buttonApplySectProp_Click" FontSize="16" IsEnabled="True"/>
        <Button Grid.Row="13" Grid.Column="1" x:Name="buttonCopyElements" Content="Copy Elements (Beta Version)" Click="buttonCopyElements_Click" FontSize="16" IsEnabled="True"/>

        <!-- Upcoming -->
        <Button Grid.Row="3" Grid.Column="2" x:Name="buttonCarbon" Content="Carbon Calulator" Click="buttonCarbon_Click" FontSize="16" IsEnabled="False"/>


        <!-- FDS Only -->
        <Button Grid.Row="3" Grid.Column="3" x:Name="buttonTransferMidas" Content="Transfer To Midas" FontSize="16" Click="buttonTransferMidas_Click" IsEnabled="False"/>
        <Button Grid.Row="4" Grid.Column="3" x:Name="buttonTrussGrouping" Content="Group Truss Sections" FontSize="16" Click="buttonTrussGrouping_Click" IsEnabled="False"/>
        <Button Grid.Row="5" Grid.Column="3" x:Name="buttonDeleteFrames" Content="Delete Frames Within Walls" FontSize="16" Click="buttonDeleteFrames_Click" IsEnabled="False"/>
        <Button Grid.Row="6" Grid.Column="3" x:Name="buttonColOptimizer" Content="RC Column Optimizer" FontSize="16" Click="buttonColOptimizer_Click" IsEnabled="False"/>
        <Button Grid.Row="7" Grid.Column="3" x:Name="buttonSteelTrussOptimizer" Content="Steel Truss Optimizer" FontSize="16" Click="buttonSteelTrussOptimizer_Click" IsEnabled="False"/>
        <Button Grid.Row="8" Grid.Column="3" x:Name="buttonCircCrack" Content="Circular RC Section Crack Width Calculator" FontSize="16" Click="buttonCircCrack_Click" IsEnabled="False"/>
        <Button Grid.Row="9" Grid.Column="3" x:Name="buttonPreWarning" Content="Grasshopper Geometry Checker" FontSize="16" Click="buttonPreWarning_Click" IsEnabled="False"/>






        <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" x:Name="buttonFeedback" Content="Feedback" FontSize="12" Margin="290 10 0 0" Click="buttonFeedback_Click" IsEnabled="True" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" x:Name="buttonHelper" Content="Help" FontSize="12" Margin="0 10 0 0" Click="buttonHelper_Click" IsEnabled="True" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Image Grid.Row="99" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="2" HorizontalAlignment="Left" Margin="11" Source="/WS_SG_ETABS_Plugin;component/src/resources/RambollFDSLogo.png"/>
        <Label Grid.Row="99" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Name="labelVersion" ></Label>
    </Grid>
</Window>
