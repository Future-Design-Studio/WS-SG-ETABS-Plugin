<Window x:Class="WS_SG_ETABS_Plugin.WindowMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src"
             mc:Ignorable="d" Height="300" Width="300" Closed="WindowMain_Closed" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10 0 10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">WS SG ETABS Plugin</Label>

        <Button Grid.Row="1" x:Name="buttonCarbon" Content="Carbon Calulator" Click="buttonCarbon_Click" FontSize="16"/>
        <Button Grid.Row="2" x:Name="buttonShellUni" Content="Shell Orientation (Local-3) Uniform" FontSize="16" Click="buttonShellUni_Click"/>
        <Button Grid.Row="3" x:Name="button3" Content="Function 3 - In Development" FontSize="16" IsEnabled="False"/>
        <Button Grid.Row="4" x:Name="buttonCopyProperties" Content="Copy Properties From Other File" FontSize="16" Click="buttonCopyProperties_Click"/>
        <Button Grid.Row="5" x:Name="buttonPlotReaction" Content="Plot Reaction" FontSize="16" Click="buttonPlotReaction_Click"/>
        
        <Image Grid.Row="6" Source="/WS_SG_ETABS_Plugin;component/src/resources/logo-invert.PNG" />


        <Label Grid.Row="7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8">version 0.0.5</Label>
    </Grid>
</Window>
