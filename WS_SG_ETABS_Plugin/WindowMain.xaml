<Window x:Class="WS_SG_ETABS_Plugin.WindowMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src"
             mc:Ignorable="d" Height="550" Width="300" Closed="WindowMain_Closed" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10 0 10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">ETABS Plugin</Label>

        <Image Grid.Row="1" Margin="5" Source="/WS_SG_ETABS_Plugin;component/src/resources/RambollFDSLogo.PNG"/>

        <Button Grid.Row="2" x:Name="buttonCarbon" Content="Carbon Calulator" Click="buttonCarbon_Click" FontSize="16"/>
        <Button Grid.Row="3" x:Name="buttonShellUni" Content="Shell Orientation (Local-3) Uniform" FontSize="16" Click="buttonShellUni_Click"/>
        <Button Grid.Row="4" x:Name="buttonRCBeamSchedule" Content="RC Beam Schedule" FontSize="16" Click="buttonRCBeamSchedule_Click"/>
        <Button Grid.Row="5" x:Name="buttonCopyProperties" Content="Copy Properties From Other File" FontSize="16" Click="buttonCopyProperties_Click"/>
        <Button Grid.Row="6" x:Name="buttonPlotReaction" Content="Plot Reaction" FontSize="16" Click="buttonPlotReaction_Click"/>
        <Button Grid.Row="7" x:Name="buttonTransferMidas" Content="Transfer To Midas" FontSize="16" Click="buttonTransferMidas_Click"/>
        <Button Grid.Row="8" x:Name="buttonSelUniqueName" Content="Select by Unique Name" FontSize="16" Click="buttonSelUniqueName_Click"/>
        <Button Grid.Row="9" x:Name="buttonEtabsToRhino" Content="Export To Rhino" FontSize="16" Click="buttonEtabsToRhino_Click"/>
        <Button Grid.Row="10" x:Name="buttonLoadCombo" Content="Load Combination EN" FontSize="16" Click="buttonLoadCombo_Click"/>
        <Button Grid.Row="11" x:Name="buttonWindCoeff" Content="Wind Coefficient Applications" FontSize="16" Click="buttonWindCoeff_Click"/>
        <Button Grid.Row="12" x:Name="buttonReleaseSelectedNode" Content="Release Frames at Specific Nodes" FontSize="16" Click="buttonReleaseSelectedNode_Click"/>
        
        
        <Label Grid.Row="13" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8">version 1.0.0</Label>
    </Grid>
</Window>
