<Window x:Class="WS_SG_ETABS_Plugin.src.punching_shear_plot.WindowPunchShrPlotLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WS_SG_ETABS_Plugin.src.punching_shear_plot"
             mc:Ignorable="d" Height="250" Width="350" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="0.6*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Margin="0 -10 0 0" Content="Plot Punching Shear Force" FontSize="20"/>
        <Label Grid.Row="1" Grid.Column="0" Margin="0 -10 0 0" Content="Loading ETABS database table..." FontSize="12"/>

        <ProgressBar Grid.Row="2" Grid.Column="0" Margin="0 3 0 3" IsIndeterminate="True"></ProgressBar>

        <Grid Grid.Row="3" Grid.Column="0" Margin=" 0 10 0 0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <CheckBox Grid.Row="0" Grid.Column="0" Name="checkBoxPointObjectConnectivity" Content="Point Object Connectivity" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="1" Grid.Column="0" Name="checkBoxJointReaction" Content="Joint Reactions" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="2" Grid.Column="0" Name="checkBoxGroupAssignments" Content="Group Assignments" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="3" Grid.Column="0" Name="checkBoxElementForcesColumns" Content="Element Forces - Columns" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="4" Grid.Column="0" Name="checkBoxColumnObjectConnectivity" Content="Column Object Connectivity" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="5" Grid.Column="0" Name="checkBoxFrameAssignmentsSectionProperties" Content="Frame Assignments - Section Properties" IsEnabled="False" IsChecked="False"></CheckBox>
            <CheckBox Grid.Row="6" Grid.Column="0" Name="checkBoxFrameDefSummary" Content="Frame Section Property Definitions - Summary" IsEnabled="False" IsChecked="False"></CheckBox>


        </Grid>
        
        
    </Grid>
</Window>
